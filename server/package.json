{
  "name": "lnk-it-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "description": "API do encurtador de links lnk.it (Fastify, Drizzle e PostgreSQL)",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/infra/http/server.ts",
    "build": "tsup src/infra/http/server.ts --format esm --target node22 --out-dir dist --clean",
    "start": "node dist/server.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1173.0",
    "@aws-sdk/lib-storage": "^3.1173.0",
    "@fastify/cors": "^11.4.3",
    "@fastify/swagger": "^9.9.5",
    "@scalar/fastify-api-reference": "^1.81.0",
    "csv-stringify": "^6.9.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^6.1.0",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/node": "^22.20.5",
    "drizzle-kit": "^0.31.11",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
