{
  "name": "lnk.it",
  "packageManager": "pnpm@10.24.0",
  "version": "1.0.0",
  "type": "module",
  "description": "Encurtador de links com Next.js, Fastify e PostgreSQL",
  "scripts": {
    "dev": "concurrently \"pnpm:dev:api\" \"pnpm:dev:web\"",
    "dev:api": "tsx watch src/infra/http/server.ts",
    "dev:web": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "concurrently --kill-others-on-fail \"pnpm run start:api\" \"pnpm run start:web\"",
    "start:api": "tsx src/infra/http/server.ts",
    "start:web": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src app next.config.ts"
  },
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@biomejs/biome": "^2.2.2",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/node": "^24.3.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.2.1",
    "next": "^15.5.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "tailwind-variants": "^3.1.1",
    "tsup": "^9.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "@fastify/cors": "^11.1.0",
    "@fastify/swagger": "^9.5.1",
    "@scalar/fastify-api-reference": "^1.35.3",
    "fastify": "^5.5.0",
    "fastify-type-provider-zod": "^6.0.0",
    "lts": "^2.0.0",
    "newrelic": "^14.13.0",
    "pg": "^8.16.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  }
}
